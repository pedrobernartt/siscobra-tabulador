# O provedor e o modelo também podem ser definidos pela aba "Configurações" do app.
# Estas variáveis são apenas um fallback (caso prefira não colar a chave na interface).

# Provedor: gemini (gratuito) | openai | anthropic
PROVIDER=gemini

# Modelo (deixe vazio para usar o padrão do provedor)
# gemini -> gemini-2.5-flash | openai -> gpt-4o-mini | anthropic -> claude-sonnet-4-5
MODEL_NAME=gemini-2.5-flash

# Chaves de API — preencha SÓ a do provedor que você vai usar.
# Gemini (camada gratuita): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# OpenAI (GPT): https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Anthropic (Claude): https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
